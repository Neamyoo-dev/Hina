uniform shader uBackground;
uniform float4 uShape;

float roundedRectSDF(float x, float y, float w, float h, float r) {
    float qx = abs(x) - w + r;
    float qy = abs(y) - h + r;
    float len = length(float2(max(qx, 0.0), max(qy, 0.0)));
    return min(max(qx, qy), 0.0) + len - r;
}

half4 main(float2 coord) {
    float2 relCoord = coord - uShape.xy;
    float2 uv = relCoord / uShape.zw;

    float ix = uv.x - 0.5;
    float iy = uv.y - 0.5;

    float sdfVal = roundedRectSDF(ix, iy, 0.5, 0.5, 0.3);

    if (sdfVal > 0.0) {
        return uBackground.eval(coord);
    }

    float edgeDist = -sdfVal;
    float normalizedDist = clamp(edgeDist / 0.5, 0.0, 1.0);

    float x = 1.0 - normalizedDist;
    float distortion = 1.0 - sqrt(max(0.0, 1.0 - x * x));

    float2 dir = float2(ix, iy);
    float dirLen = length(dir);
    float2 normDir = dirLen < 0.001 ? float2(0.0) : dir / dirLen;

    float maxOffset = 50.0;
    float2 displacedCoord = coord + distortion * normDir * maxOffset;

    float blurAmt = 6.0;
    float wCenter = 0.18;
    float wCardinal = 0.14;
    float wDiagonal = 0.055;
    float wInner = 0.01;

    half4 color = uBackground.eval(displacedCoord) * wCenter;

    color += uBackground.eval(displacedCoord + float2(blurAmt, 0.0)) * wCardinal;
    color += uBackground.eval(displacedCoord - float2(blurAmt, 0.0)) * wCardinal;
    color += uBackground.eval(displacedCoord + float2(0.0, blurAmt)) * wCardinal;
    color += uBackground.eval(displacedCoord - float2(0.0, blurAmt)) * wCardinal;

    color += uBackground.eval(displacedCoord + float2(blurAmt * 0.5, blurAmt * 0.5)) * wDiagonal;
    color += uBackground.eval(displacedCoord - float2(blurAmt * 0.5, blurAmt * 0.5)) * wDiagonal;
    color += uBackground.eval(displacedCoord + float2(-blurAmt * 0.5, blurAmt * 0.5)) * wDiagonal;
    color += uBackground.eval(displacedCoord + float2(blurAmt * 0.5, -blurAmt * 0.5)) * wDiagonal;

    color += uBackground.eval(displacedCoord + float2(blurAmt * 0.25, 0.0)) * wInner;
    color += uBackground.eval(displacedCoord - float2(blurAmt * 0.25, 0.0)) * wInner;
    color += uBackground.eval(displacedCoord + float2(0.0, blurAmt * 0.25)) * wInner;
    color += uBackground.eval(displacedCoord - float2(0.0, blurAmt * 0.25)) * wInner;

    float edgeFactor = 1.0 - smoothstep(0.0, 0.3, edgeDist);
    float chromaticStrength = edgeFactor * 5.0;
    half4 rSample = uBackground.eval(displacedCoord - normDir * chromaticStrength);
    half4 bSample = uBackground.eval(displacedCoord + normDir * chromaticStrength);
    color.r = rSample.r;
    color.b = bSample.b;

    float fresnel = pow(1.0 - normalizedDist, 3.0) * 0.25;
    half4 fresnelColor = half4(0.85, 0.9, 1.0, 1.0) * fresnel;

    float angle = atan(iy, ix);
    float glare1 = pow(max(0.0, cos(angle + 0.2)), 24.0);
    float glare2 = pow(max(0.0, cos(angle + 2.8)), 24.0);
    float glare = (glare1 + glare2) * 0.12 * (1.0 - normalizedDist * 0.5);

    color.rgb += fresnelColor.rgb + half3(glare);

    float luminance = dot(color.rgb, half3(0.299, 0.587, 0.114));
    color.rgb = mix(half3(luminance), color.rgb, 1.08);
    color.rgb = clamp(color.rgb, 0.0, 1.0);

    float bgLuminance = dot(uBackground.eval(coord).rgb, half3(0.299, 0.587, 0.114));
    float alpha = mix(0.6, 0.85, bgLuminance);

    return half4(color.rgb, alpha);
}
